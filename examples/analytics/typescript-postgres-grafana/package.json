{
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "start": "node --enable-source-maps dist/server.js",
    "dev": "tsup src/*.ts --watch --onSuccess \"node --enable-source-maps dist/server.js\"",
    "build": "tsup src/*.ts --minify --dts-resolve",
    "check-types": "tsc --noEmit --skipLibCheck",
    "test": "tsc --outDir dist-tests --skipLibCheck && node --test tests/*.test.cjs",
    "update": "yarn up -R '*' && yarn dedupe --strategy highest",
    "latest": "yarn npm-check-updates -i -m --packageManager yarn --install never && yarn install"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.11.1",
    "reflect-metadata": "^0.2.2",
    "tsup": "^9.0.0",
    "typeorm": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@swc/core": "^1.3.67",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "npm-check-updates": "^23.1.1",
    "pg-mem": "3.0.14"
  }
}
